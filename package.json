{
  "name": "ecommerce-auth-api",
  "version": "1.0.0",
  "description": "E-commerce Authentication API with Register & Login",
  "main": "dist/server.js",
  "scripts": {
    "dev":                "ts-node-dev --respawn --transpile-only src/server.ts",
    "build":              "tsc",
    "start":              "node dist/server.js",
    "migration:run":      "typeorm-ts-node-commonjs migration:run -d src/datasource.config.ts",
    "migration:revert":   "typeorm-ts-node-commonjs migration:revert -d src/datasource.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/datasource.config.ts",
    "migration:create":   "typeorm-ts-node-commonjs migration:create"
  },
  "keywords": [
    "ecommerce",
    "auth",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.1",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.19",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
